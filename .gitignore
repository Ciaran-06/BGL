# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# Compiled extensions (for example from an accidental mypyc run)
*.so
*.pyd

# --- Tools ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/
allure-results/
allure-report/

# --- Environment and secrets ---
.env
.env.*

# --- Operating system files ---
.DS_Store
Thumbs.db
desktop.ini

# --- BGL local state ---
# Machine-local BGL state: writer identity, run locks, the ledger lock and
# temporarily decrypted holdout files. Never commit it.
# `bgl init` adds this line, and the other lines a project needs, to every
# project that uses BGL.
.bgl/